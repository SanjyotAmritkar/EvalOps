# EvalOps environment configuration -- TEMPLATE ONLY.
#
# Usage: copy this file to .env and fill in values as needed. .env is
# git-ignored; never commit real secrets.
#
# This file is for the NON-containerized local dev flow (uv run uvicorn / npm
# run dev / uv run celery, each on localhost). The containerized stack
# (`docker compose up`, CP 10.4) fixes DATABASE_URL / CELERY_BROKER_URL /
# API_PROXY_TARGET to Compose's own service hostnames (postgres/redis/api)
# directly in docker-compose.yml -- those three are NOT read from this file
# when running under Compose; only provider keys and the tuning variables
# below are (Compose auto-loads a `.env` in the same directory for
# `${VAR}` substitution). See "Run the full stack with Docker" in the README.
#
# The Azure production deployment (Phase 10, CP 10.5) sets its own equivalents
# as Container Apps secrets/env vars, not from this file -- see
# deploy/azure/README.md and docs/ARCHITECTURE.md §7.11 for that topology and
# variable names (still placeholders only, never real values).

# --- Database (Phase 2) ---
# PostgreSQL connection string used by SQLAlchemy and Alembic. When unset,
# evalops.db.engine falls back to a local development default. Not required for
# the deterministic mock evaluation path.
DATABASE_URL=postgresql+psycopg://evalops:evalops@localhost:5432/evalops

# --- Local model provider (Phase 1, backend: ollama) ---
# From a container, "localhost" means the container itself, not your host --
# see the README's "Ollama and container networking" note for the
# platform-specific address (Docker Desktop's host.docker.internal vs Linux).
OLLAMA_BASE_URL=http://localhost:11434

# --- Background execution (Phase 4, Celery + Redis) ---
# Redis broker for the Celery worker. Matches infra/docker-compose.yml. Redis is
# broker-only; PostgreSQL stays the source of truth for runs and results.
CELERY_BROKER_URL=redis://localhost:6379/0

# --- Hosted model providers (Phase 6, backend: openai / anthropic / live) ---
# Required only when a SystemVersion (or an llm_judge evaluator) targets that
# provider. Read from the environment ONLY -- never put a key in a run config,
# the database, a request body, or a committed file. Leave blank to keep the
# local Ollama / mock paths fully functional without any cloud credentials.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Dashboard API proxy (non-containerized `npm run dev` only) ---
# See dashboard/.env.example. Under Compose this is fixed to http://api:8000.
API_PROXY_TARGET=http://127.0.0.1:8000

# --- Structured logging (Phase 10, CP 10.3) ---
# EVALOPS_LOG_FORMAT: "json" (default; machine-readable) or "console" (compact,
# for a human watching a terminal). EVALOPS_LOG_LEVEL: standard logging level
# names, default INFO.
EVALOPS_LOG_LEVEL=INFO
EVALOPS_LOG_FORMAT=json

# --- Operational metadata (Phase 10, CP 10.3) ---
# Surfaced read-only by GET /health and GET /ready. EVALOPS_REVISION (or
# GIT_SHA / GIT_COMMIT / SOURCE_COMMIT) is never derived by shelling out to
# git; leave unset to report null rather than a fabricated value.
EVALOPS_ENV=development
EVALOPS_REVISION=

# --- Readiness (Phase 10, CP 10.3 / CP 10.4) ---
# Whether GET /ready must see Redis to report "ready". Set to false only for a
# deliberately Redis-less synchronous deployment (no /run-async use).
EVALOPS_REQUIRE_REDIS=true

# --- Celery worker tuning (Phase 10, CP 10.4) ---
# Container concurrency for `docker compose up` (see docker-compose.yml).
# Appropriate for a single-machine local/demo deployment; raise for more
# parallel evaluation runs.
CELERY_CONCURRENCY=2
# Safety-net time limits in seconds for one evaluation task, not a retry --
# see src/evalops/worker/celery_app.py's module docstring for the full
# at-most-once delivery rationale. 0/blank disables a limit; a real, large,
# hosted-provider run can legitimately take a long time.
CELERY_TASK_SOFT_TIME_LIMIT_S=1800
CELERY_TASK_TIME_LIMIT_S=1900

# --- API authentication (Phase 10, CP 10.5) ---
# A single portfolio-scale API key -- not OAuth, not per-user accounts. Blank
# (the default) means auth is OFF: every request is allowed, which is what
# local development and the test suite rely on. REQUIRED when EVALOPS_ENV=
# production -- the API refuses to start without it (see
# src/evalops/security/settings.py). Callers send it as
# `Authorization: Bearer <key>` (curl, the dashboard's server-side proxy, or
# any other direct client). Generate one with e.g. `openssl rand -hex 32`;
# never commit the real value, and never put it in a NEXT_PUBLIC_* variable.
EVALOPS_API_KEY=

# --- CORS (Phase 10, CP 10.5) ---
# Comma-separated browser origins allowed to call the API cross-origin.
# Blank (the default) means no CORS headers are sent at all -- safe, and
# sufficient for normal operation: the dashboard talks to the API through its
# own server-side proxy, which is never subject to browser CORS. Only set
# this for a genuine direct-from-browser integration. Never a wildcard; never
# combined with credentialed requests (this API does not use cookies).
EVALOPS_CORS_ALLOWED_ORIGINS=
