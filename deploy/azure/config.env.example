# Azure deployment configuration -- TEMPLATE ONLY (Phase 10, CP 10.5).
#
# Copy to config.env (git-ignored -- see deploy/azure/.gitignore) and fill in
# real names for YOUR subscription. Every value below is a resource NAME or a
# non-secret setting, never a credential: Postgres's admin password, the
# EvalOps API key, and provider keys are generated once during
# 00-provision-infra.sh / 01-provision-apps.sh and stored only as Container
# Apps secrets / your own password manager -- never written to this file, a
# script, a log, or the repo.
#
# The GitHub Actions deployment workflow (.github/workflows/deploy-azure.yml)
# does not read this file -- it uses the equivalent GitHub Actions
# repository/environment variables and secrets (names listed in
# deploy/azure/README.md). This file is for running the numbered scripts by
# hand.

# --- Subscription / location -------------------------------------------
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_LOCATION=eastus

# --- Resource group ------------------------------------------------------
RESOURCE_GROUP=evalops-prod-rg

# --- Container registry --------------------------------------------------
# Globally unique, alphanumeric only.
ACR_NAME=evalopsprodacr

# --- Managed identity (Container Apps -> ACR pull; no admin credentials) ---
IDENTITY_NAME=evalops-prod-acr-pull

# --- Container Apps environment ------------------------------------------
CONTAINERAPPS_ENV=evalops-prod-env
LOG_ANALYTICS_WORKSPACE=evalops-prod-logs

# --- PostgreSQL Flexible Server -------------------------------------------
POSTGRES_SERVER_NAME=evalops-prod-pg
POSTGRES_ADMIN_USER=evalopsadmin
POSTGRES_DB_NAME=evalops
# SKU/tier kept small and explicit here rather than an IaC default guess --
# see README for the tradeoffs of changing this.
POSTGRES_SKU=Standard_B1ms
POSTGRES_STORAGE_GB=32

# --- Redis (Container App broker -- see README for why, not Azure Cache) ---
REDIS_APP_NAME=evalops-prod-redis

# --- Application Container Apps ------------------------------------------
API_APP_NAME=evalops-prod-api
WORKER_APP_NAME=evalops-prod-worker
DASHBOARD_APP_NAME=evalops-prod-dashboard
MIGRATE_JOB_NAME=evalops-prod-migrate

# --- Worker tuning (matches .env.example) --------------------------------
CELERY_CONCURRENCY=2

# --- GitHub Actions OIDC deployment identity ------------------------------
# A *separate* identity from IDENTITY_NAME above -- see 03-github-oidc.sh for
# why. GITHUB_ORG/GITHUB_REPO scope the federated-credential trust to this
# exact repository's "production" Environment; nothing else can assume it.
GITHUB_DEPLOY_IDENTITY_NAME=evalops-prod-github-deploy
GITHUB_ORG=your-github-org-or-username
GITHUB_REPO=EvalOps
